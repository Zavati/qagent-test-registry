{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "qagent-test-registry",
  "main": "src/index.js",
  "compatibility_date": "2026-01-14",
  "workers_dev": false,
  "vars": {
    "ENVIRONMENT": "development",
    "SERVICE_NAME": "qagent-test-registry",
    "TEST_REGISTRY_MAX_SPEC_BYTES": "262144",
    "TEST_REGISTRY_MAX_REQUEST_BYTES": "393216"
  },
  "d1_databases": [
    {
      "binding": "TEST_REGISTRY_DB",
      "database_name": "qagent-test-registry-dev",
      "database_id": "5d6a1abf-512e-4f47-b86c-c80f8c10117c",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
