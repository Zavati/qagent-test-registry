{
  "name": "qagent-test-registry",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "QAgent Test Artifact Plane - immutable Test Design registry foundation.",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check:deploy-config": "node scripts/verify-deploy-config.mjs",
    "db:migrations:apply": "wrangler d1 migrations apply TEST_REGISTRY_DB --remote",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:audit:remote": "wrangler d1 execute TEST_REGISTRY_DB --remote --file=scripts/production-audit-07.6.5-f.sql"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "wrangler": "^4.59.2"
  }
}
