{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qagent.suite-execution-slice.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "organizationId", "projectId", "suite", "offset", "limit", "totalItems", "items", "nextOffset", "hasMore", "projection"],
  "properties": {
    "contractVersion": { "const": "qagent.suite-execution-slice.v1" },
    "organizationId": { "type": "string" },
    "projectId": { "type": "string" },
    "suite": { "type": "object" },
    "offset": { "type": "integer", "minimum": 0 },
    "limit": { "type": "integer", "minimum": 1, "maximum": 25 },
    "totalItems": { "type": "integer", "minimum": 0 },
    "items": {
      "type": "array",
      "maxItems": 25,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ordinal", "endpointId", "testDesignId", "testDesignVersionId", "testDesignVersion", "scenarioCount", "scenarioIds"],
        "properties": {
          "ordinal": { "type": "integer", "minimum": 0 },
          "endpointId": { "type": "string" },
          "testDesignId": { "type": "string", "pattern": "^td_" },
          "testDesignVersionId": { "type": "string", "pattern": "^tdv_" },
          "testDesignVersion": { "type": "integer", "minimum": 1 },
          "scenarioCount": { "type": "integer", "minimum": 1 },
          "scenarioIds": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    },
    "nextOffset": { "type": "integer", "minimum": 0 },
    "hasMore": { "type": "boolean" },
    "projection": { "type": "object" }
  }
}
